{
  "entities": {
    "BusinessAccount": {
      "title": "BusinessAccount",
      "description": "Business owner profile, subscription tier, countdown timestamps, and moderation status",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "ownerEmail": { "type": "string", "description": "Owner verified email" },
        "shopName": { "type": "string", "description": "Business or shop name" },
        "ownerName": { "type": "string", "description": "Business owner full name" },
        "phone": { "type": "string", "description": "Business mobile number" },
        "address": { "type": "string", "description": "Shop address" },
        "businessType": { "type": "string", "description": "Type of business" },
        "logoUri": { "type": "string", "description": "Local or remote logo URI" },
        "subscriptionTier": { "type": "string", "enum": ["FREE", "BASIC", "PREMIUM", "BUSINESS"] },
        "subscriptionMonths": { "type": "integer" },
        "subscriptionStartMillis": { "type": "integer" },
        "subscriptionExpiresAtMillis": { "type": "integer" },
        "blocked": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "BANNED"] },
        "banReason": { "type": "string" },
        "suspendedUntilMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "shopName", "ownerName", "phone", "address", "businessType", "subscriptionTier", "subscriptionMonths", "subscriptionExpiresAtMillis", "blocked", "createdAt", "updatedAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Business branch location",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "mainBranch": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "address", "phone", "mainBranch", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product scoped to user and branch",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "branchId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellPrice": { "type": "number" },
        "stockQty": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "photoUri": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "branchId", "name", "sku", "category", "costPrice", "sellPrice", "stockQty", "minStockAlert", "createdAt", "updatedAt"]
    },
    "Party": {
      "title": "Party",
      "description": "Customer or supplier khata account",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "branchId": { "type": "string" },
        "partyType": { "type": "string", "enum": ["CUSTOMER", "SUPPLIER"] },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "branchId", "partyType", "name", "phone", "address", "totalAmount", "paidAmount", "dueAmount", "createdAt", "updatedAt"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "Sale, purchase, due collection, supplier payment, income, or expense entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "branchId": { "type": "string" },
        "txType": { "type": "string", "enum": ["SALE", "PURCHASE", "DUE_COLLECTION", "SUPPLIER_PAYMENT", "INCOME", "EXPENSE"] },
        "partyId": { "type": "string" },
        "partyName": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "cogsTotal": { "type": "number" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["COMPLETED", "CANCELLED"] },
        "operatorName": { "type": "string" },
        "lineItemsJson": { "type": "string" },
        "txDateMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "branchId", "txType", "partyId", "partyName", "subtotal", "discount", "totalAmount", "paidAmount", "dueAmount", "cogsTotal", "category", "note", "status", "operatorName", "lineItemsJson", "txDateMillis", "createdAt", "updatedAt"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Immutable inventory stock movement history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "branchId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "changeQty": { "type": "number" },
        "reason": { "type": "string" },
        "referenceTxId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "branchId", "productId", "productName", "changeQty", "reason", "referenceTxId", "createdAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee profile and role-based permissions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["MANAGER", "EMPLOYEE"] },
        "pinCode": { "type": "string" },
        "branchId": { "type": "string" },
        "canSell": { "type": "boolean" },
        "canPurchase": { "type": "boolean" },
        "canViewReports": { "type": "boolean" },
        "canManageStock": { "type": "boolean" },
        "monthlySalary": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "phone", "role", "pinCode", "branchId", "canSell", "canPurchase", "canViewReports", "canManageStock", "monthlySalary", "active", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Business and platform notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string" },
        "readFlag": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "body", "category", "readFlag", "createdAt"]
    },
    "ServerClockSync": {
      "title": "ServerClockSync",
      "description": "Server timestamp heartbeat for tamper-resistant subscription countdown verification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serverTime": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serverTime"]
    },
    "SubscriptionPackage": {
      "title": "SubscriptionPackage",
      "description": "SaaS subscription tier configuration with per-duration pricing managed by Super Admin",
      "type": "object",
      "properties": {
        "tier": { "type": "string", "enum": ["FREE", "BASIC", "PREMIUM", "BUSINESS"] },
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "monthlyPriceBdt": { "type": "number" },
        "price1mBdt": { "type": "number" },
        "price3mBdt": { "type": "number" },
        "price6mBdt": { "type": "number" },
        "price12mBdt": { "type": "number" },
        "maxBranches": { "type": "integer" },
        "maxEmployees": { "type": "integer" },
        "aiEnabled": { "type": "boolean" },
        "exportEnabled": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "featuresSummaryBn": { "type": "string" },
        "featuresSummaryEn": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tier", "nameBn", "nameEn", "monthlyPriceBdt", "maxBranches", "maxEmployees", "aiEnabled", "exportEnabled", "updatedAt"]
    },
    "PackagePriceHistory": {
      "title": "PackagePriceHistory",
      "description": "Immutable package pricing and feature change history log",
      "type": "object",
      "properties": {
        "tier": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "previousMonthlyBdt": { "type": "number" },
        "newMonthlyBdt": { "type": "number" },
        "price1mBdt": { "type": "number" },
        "price3mBdt": { "type": "number" },
        "price6mBdt": { "type": "number" },
        "price12mBdt": { "type": "number" },
        "maxBranches": { "type": "integer" },
        "maxEmployees": { "type": "integer" },
        "packageEnabled": { "type": "boolean" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tier", "actorUid", "actorEmail", "previousMonthlyBdt", "newMonthlyBdt", "summary", "createdAt"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Dynamic bKash and Nagad merchant payment settings controlled by Super Admin",
      "type": "object",
      "properties": {
        "bkashAccountName": { "type": "string" },
        "bkashNumber": { "type": "string" },
        "bkashEnabled": { "type": "boolean" },
        "nagadAccountName": { "type": "string" },
        "nagadNumber": { "type": "string" },
        "nagadEnabled": { "type": "boolean" },
        "instructionsBn": { "type": "string" },
        "instructionsEn": { "type": "string" },
        "updatedByEmail": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bkashAccountName", "bkashNumber", "bkashEnabled", "nagadAccountName", "nagadNumber", "nagadEnabled", "instructionsBn", "instructionsEn", "updatedAt"]
    },
    "TrxRegistryEntry": {
      "title": "TrxRegistryEntry",
      "description": "Global duplicate transaction ID lock entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "trxKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "trxKey", "createdAt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Manual bKash/Nagad subscription payment verification request with locked-in pricing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "shopName": { "type": "string" },
        "method": { "type": "string", "enum": ["BKASH", "NAGAD"] },
        "senderNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "amountBdt": { "type": "number" },
        "lockedUnitMonthlyBdt": { "type": "number" },
        "packageTier": { "type": "string", "enum": ["BASIC", "PREMIUM", "BUSINESS"] },
        "durationMonths": { "type": "integer" },
        "screenshotUri": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "adminNote": { "type": "string" },
        "reviewedByEmail": { "type": "string" },
        "reviewedAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "shopName", "method", "senderNumber", "transactionId", "amountBdt", "packageTier", "durationMonths", "status", "adminNote", "createdAt", "updatedAt"]
    },
    "SubscriptionRenewal": {
      "title": "SubscriptionRenewal",
      "description": "Immutable subscription activation and renewal ledger",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "shopName": { "type": "string" },
        "paymentRequestId": { "type": "string" },
        "packageTier": { "type": "string", "enum": ["BASIC", "PREMIUM", "BUSINESS"] },
        "durationMonths": { "type": "integer" },
        "amountBdt": { "type": "number" },
        "startedAtMillis": { "type": "integer" },
        "expiresAtMillis": { "type": "integer" },
        "approvedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "paymentRequestId", "packageTier", "durationMonths", "amountBdt", "startedAtMillis", "expiresAtMillis", "approvedByEmail", "createdAt"]
    },
    "ComplaintTicket": {
      "title": "ComplaintTicket",
      "description": "Customer complaint and support ticket",
      "type": "object",
      "properties": {
        "ticketCode": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "shopName": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "attachmentUri": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "RESOLVED", "REJECTED"] },
        "lastReplyText": { "type": "string" },
        "lastReplyBy": { "type": "string" },
        "lastReplyAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketCode", "userId", "userEmail", "shopName", "subject", "description", "status", "createdAt", "updatedAt"]
    },
    "ComplaintReply": {
      "title": "ComplaintReply",
      "description": "Timestamped reply message inside a complaint ticket thread",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["CUSTOMER", "SUPER_ADMIN", "SUB_ADMIN"] },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "senderUid", "senderName", "senderRole", "message", "createdAt"]
    },
    "ModerationHistory": {
      "title": "ModerationHistory",
      "description": "Immutable suspend, ban, and unban history with mandatory reason",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "shopName": { "type": "string" },
        "action": { "type": "string", "enum": ["SUSPEND", "BAN", "UNBAN"] },
        "reason": { "type": "string" },
        "suspendedUntilMillis": { "type": "integer" },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "reason", "actorUid", "actorEmail", "createdAt"]
    },
    "EmailOutbox": {
      "title": "EmailOutbox",
      "description": "Server-side email dispatch queue awaiting backend SMTP/Trigger Email integration",
      "type": "object",
      "properties": {
        "recipientEmail": { "type": "string" },
        "emailType": { "type": "string", "enum": ["ORDER_ALERT_OWNER", "PAYMENT_APPROVED", "PAYMENT_REJECTED", "COMPLAINT_REPLY"] },
        "subject": { "type": "string" },
        "bodyPreview": { "type": "string" },
        "relatedUserId": { "type": "string" },
        "relatedOrderId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_BACKEND_CONFIG", "SENT", "FAILED"] },
        "statusNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientEmail", "emailType", "subject", "bodyPreview", "relatedUserId", "status", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Super Admin and Sub Admin RBAC assignments",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "SUB_ADMIN"] },
        "canVerifyPayments": { "type": "boolean" },
        "canManageUsers": { "type": "boolean" },
        "canReplyComplaints": { "type": "boolean" },
        "canViewLimitedReports": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "canVerifyPayments", "canManageUsers", "canViewLimitedReports", "active", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable admin audit log",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "action", "targetId", "details", "createdAt"]
    }
  },
  "firestore": {
    "/business_accounts/{userId}": {
      "schema": { "$ref": "#/entities/BusinessAccount" },
      "description": "Business owner accounts and subscription statuses"
    },
    "/users/{userId}/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Owner-isolated branches"
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Owner-isolated product inventory"
    },
    "/users/{userId}/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Owner-isolated customer and supplier ledgers"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/TransactionRecord" },
      "description": "Owner-isolated sales, purchases, due collections, income, and expenses"
    },
    "/users/{userId}/stock_logs/{logId}": {
      "schema": { "$ref": "#/entities/StockLog" },
      "description": "Owner-isolated immutable stock movement logs"
    },
    "/users/{userId}/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Owner-isolated staff RBAC definitions"
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Owner-isolated notifications"
    },
    "/users/{userId}/clock_sync/{syncId}": {
      "schema": { "$ref": "#/entities/ServerClockSync" },
      "description": "Owner server timestamp heartbeat for tamper-resistant subscription expiry checks"
    },
    "/subscription_packages/{packageId}": {
      "schema": { "$ref": "#/entities/SubscriptionPackage" },
      "description": "SaaS subscription package tiers"
    },
    "/package_price_history/{historyId}": {
      "schema": { "$ref": "#/entities/PackagePriceHistory" },
      "description": "Package pricing and feature change history log"
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/PaymentSettings" },
      "description": "Global bKash/Nagad payment settings configured by Super Admin"
    },
    "/trx_registry/{trxKey}": {
      "schema": { "$ref": "#/entities/TrxRegistryEntry" },
      "description": "Global unique Transaction ID registry preventing duplicate payment TrxIDs"
    },
    "/payment_requests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Manual bKash and Nagad subscription payment requests"
    },
    "/subscription_renewals/{renewalId}": {
      "schema": { "$ref": "#/entities/SubscriptionRenewal" },
      "description": "Immutable subscription activation and renewal history"
    },
    "/complaints/{ticketId}": {
      "schema": { "$ref": "#/entities/ComplaintTicket" },
      "description": "Customer complaints and support tickets"
    },
    "/complaints/{ticketId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/ComplaintReply" },
      "description": "Complaint reply thread messages"
    },
    "/moderation_history/{historyId}": {
      "schema": { "$ref": "#/entities/ModerationHistory" },
      "description": "Suspend, Ban, and Unban moderation history"
    },
    "/email_outbox/{mailId}": {
      "schema": { "$ref": "#/entities/EmailOutbox" },
      "description": "Email outbox queue awaiting backend SMTP/Trigger Email configuration"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Super Admin and Sub Admin role records"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit logs"
    }
  }
}
